VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Free NLT API key from https://api.nlt.to/Account/Register (non-commercial
# use only — see the license note in src/data/bibleTranslations.ts). Omitting
# this falls back to Tyndale's anonymous, more tightly rate-limited access.
VITE_NLT_API_KEY=your-nlt-api-key-here

# api.bible API key (from your api.bible dashboard), used for NIV. Check that
# account's Plan page for usage limits/commercial terms — see the license
# note in src/data/bibleTranslations.ts.
VITE_API_BIBLE_KEY=your-api-bible-key-here
